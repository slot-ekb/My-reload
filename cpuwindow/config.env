# cpuwindow — max вокруг cuckoo, normal в остальное.
SRC="auto"             # auto: локальный прокси (3400/3401) если есть, иначе нода из конфига пакета
LEAD=1                 # за сколько блоков ДО куку греть. 1 => вкл на %25==3, выкл на %25==5
PERIOD=25
CUCKOO_MOD=4           # cuckoo на height%25==4 (04/29/54/79)
HOT="/opt/cpuwindow/cpumode.sh max"
COLD="/opt/cpuwindow/cpumode.sh normal"
