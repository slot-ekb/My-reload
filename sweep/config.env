# ===== sweep — умолчания =====
BIN=orig                 # бинарь майнера: orig | range
SECS=40                  # длительность одного замера, сек
THREADS="1 2 4 6 8"      # какие nthreads перебрать для ОДНОГО солвера
COMPARE=on               # on = ещё гонять "N солверов×1 поток" на тех же ядрах для сравнения
# порты стенда (свои, чтобы не конфликтовать с testgc 3599/3500)
FAKE_PORT=3699
PROXY_PORT=3600
