# ===== testgc: значения ПО УМОЛЧАНИЮ (аргументы командной строки их перебивают) =====
BIN=orig            # какой бинарь майнера: orig | range
RANGE=1             # значение EPIC_RANGE (для range-бинаря)
SECS=60             # длительность замера, сек

# --- CPU ---
CPU_WORKERS=0       # ядер/воркеров: 0=авто (физ.ядра-CPU_RESERVE), по 1 воркеру на ЯДРО
CPU_RESERVE=2       # сколько физ.ядер оставить системе (при CPU_WORKERS=0)
CPU_INSTANCES=1     # солверов в одном воркере
CPU_NTHREADS=1      # потоков на солвер

# --- GPU ---
GPU_CARDS=0         # 0 = все карты (nvidia-smi -L), иначе точное число
GPU_INSTANCES=1     # солверов на одну карту

# --- фейк-нода ---
ROTATE_JOB=0        # 0 = задание не меняется (stale=0). N сек = менять блок каждые N сек -> появятся реальные stale

# --- порты теста (СВОИ, чтобы не конфликтовать с боевым прокси 3400/3401) ---
FAKE_PORT=3599
CPU_PROXY_PORT=3500
GPU_PROXY_PORT=3501
