# ===== proxycpu1 — CPU-пакет. Все крутилки тут. =====
NODE="ЗАДАЙ_АДРЕС_НОДЫ:28061"   # адрес ноды (стратум). install-cpu ставит сам.
PROXY_PORT="3400"           # локальный порт прокси (если USE_PROXY=on)
USE_PROXY=off               # off = майнеры ПРЯМО на NODE | on = через прокси(:PROXY_PORT)

# --- раскладка (как аргументы mtest) ---
WORKERS=0                   # число ПРОЦЕССОВ майнера. 0 = авто (заполнить ядра). Можно > физ.ядер -> HT.
INSTANCES=1                 # солверов в одном процессе
NTHREADS=1                  # потоков на один солвер
RESERVE=2                   # сколько нитей оставить системе (при WORKERS=0)
# каждому процессу выделяется INSTANCES*NTHREADS нитей. По шарам оптимум обычно
# WORKERS=0, INSTANCES=1, NTHREADS=1 (максимум независимых солверов, 1 поток каждый).

# --- бинарь ---
MINER=orig                  # orig (универсальный, и на Ubuntu20) | range (range-режим)
RANGE=1                     # EPIC_RANGE — ТОЛЬКО для MINER=range; с orig игнорируется

# --- логи/питание ---
LOGS=off                    # off = тишина | on = лог только w0
LOG_MAX_MB=100
PROXYLOG=off                # лог прокси (при USE_PROXY=on)
PERF=off                    # on = ставить CPU governor=performance при старте

PROC_PER_GPU=2              # (для GPU-ригов) процессов на карту — CPU это не трогает
