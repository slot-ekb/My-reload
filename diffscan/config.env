# ===== diffscan — умолчания =====
BIN=orig                 # бинарь майнера: orig | range
SECS=60                  # длительность замера, сек
WORKERS=4                # процессов майнера (пинятся по физ.ядрам с ядра 0)
INSTANCES=1              # солверов в процессе
NTHREADS=1               # потоков на солвер
DIFF=1                   # share difficulty (1 = майнер шлёт ВСЕ шары; вес считаем сами)
LOGW=off                 # on = печатать вес каждой шары (шумно), off = только гистограмма
FAKE_PORT=3799           # свой порт (не конфликтует с testgc/sweep)
